# Claude API key (or run `ant auth login` on the host)
ANTHROPIC_API_KEY=

# Server
PORT=8787
# Origins of the CARE frontend allowed to call the agent, comma separated
VOICE_AGENT_ALLOWED_ORIGINS=http://localhost:4000

# The agent only answers signed-in CARE users: it checks the caller's
# access token against this CARE backend.
CARE_API_URL=http://127.0.0.1:9000
VOICE_AGENT_REQUIRE_AUTH=true

# Questions per user per 10 minutes
VOICE_AGENT_RATE_LIMIT=30

# Source code the agent learns CARE from. The frontend (this repo) is always
# included; add the backend and any plugins for full answers.
# CARE_FE_DIR=/srv/care_fe
CARE_BACKEND_DIR=/srv/care
CARE_EXTRA_SOURCES=care_token_display=/srv/care_token_display

# Model settings
VOICE_AGENT_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max — higher is more thorough but slower
VOICE_AGENT_EFFORT=medium
VOICE_AGENT_MAX_ITERATIONS=25
